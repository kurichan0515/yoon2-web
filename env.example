# Firebase設定
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# SNS設定
# 注意: 店舗情報・営業時間・基本料金は src/config/appConfig.ts で直接管理
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/yoo.n.yoo.n/
NEXT_PUBLIC_LINE_URL=https://lin.ee/lyyKSqu

# Google Calendar API設定
NEXT_PUBLIC_GOOGLE_API_KEY=your_google_api_key_here
NEXT_PUBLIC_GOOGLE_CALENDAR_ID=your_calendar_id_here

# Google AdSense設定
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-6862900859746528
NEXT_PUBLIC_ADSENSE_DEFAULT_SLOT=2647640133
NEXT_PUBLIC_ADSENSE_ENABLED=true
NEXT_PUBLIC_ADSENSE_DEV_MODE=false

# Google Ads設定
# コンバージョンID: AW-XXXXXXXXXX 形式
